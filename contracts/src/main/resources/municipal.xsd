<?xml version="1.0" encoding="UTF-8"?>
<!--
  EcoTrack <-> municipal information system: SOAP contract (data types).
  Written FIRST (contract-first), before any Java code. The WSDL is generated from this file by Spring-WS
  at runtime (/ws/municipal.wsdl) and the Java classes are generated from it by the `contracts` Maven module.

  Operations: SubmitCollectionRecord, GetRecordStatus.
  Faults: RecordRejectedFault (business rejection), plus the Client fault Spring-WS raises when a
  message does not validate against this schema.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:m="http://ecotrack.example/municipal"
           targetNamespace="http://ecotrack.example/municipal"
           elementFormDefault="qualified">

  <xs:element name="SubmitCollectionRecordRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="recordId"      type="m:UuidType"/>   <!-- idempotency key: the collection id -->
        <xs:element name="reportId"  type="m:UuidType"/>
        <xs:element name="collectionId"     type="m:UuidType"/>
        <xs:element name="completedAt"     type="xs:dateTime"/>
        <xs:element name="address"        type="xs:string" minOccurs="0"/>
        <xs:element name="notes"          type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="SubmitCollectionRecordResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="accepted"             type="xs:boolean"/>
        <xs:element name="municipalReference" type="xs:string"/>
        <xs:element name="receivedAt"              type="xs:dateTime"/>
        <xs:element name="duplicate"            type="xs:boolean"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="GetRecordStatusRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="recordId" type="m:UuidType"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="GetRecordStatusResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="found"              type="xs:boolean"/>
        <xs:element name="status"              type="xs:string" minOccurs="0"/>
        <xs:element name="municipalReference" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Detail of the fault returned when a well-formed record breaks a business rule. -->
  <xs:element name="RecordRejectedFault">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="code"    type="xs:string"/>
        <xs:element name="message" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:simpleType name="UuidType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
