# Copy to .env to override. docker compose also works WITHOUT a .env file: the defaults in docker-compose.yml are
# throw-away development values for a local demo, never real secrets. Do not commit your own .env.
POSTGRES_PASSWORD=change-me-postgres
REPORTS_DB_PASSWORD=change-me-reports
COLLECTIONS_DB_PASSWORD=change-me-collections
MUNICIPAL_DB_PASSWORD=change-me-municipal

# Host ports
GATEWAY_PORT=8080
POSTGRES_HOST_PORT=5432
FRONTEND_PORT=3000

# Demo: seconds between collection states (PLANNED -> IN_PROGRESS -> COMPLETED)
SIMULATION_STEP_SECONDS=10
